# Lab 8 MQTT Configuration
# Copy this file to .env and update with your actual values
# The .env file is gitignored for security

# WiFi Configuration
WIFI_SSID=YourNetworkName
WIFI_PASSWORD=YourNetworkPassword

# MQTT Broker Configuration
MQTT_BROKER=192.168.1.100  # Your Raspberry Pi's IP address
MQTT_PORT=1883
MQTT_TOPIC=temp/pico

# Publisher Configuration
PUBLISHER_CLIENT_ID=publisher
PUBLISH_INTERVAL=2  # Seconds between temperature readings

# Subscriber Configuration
SUBSCRIBER_CLIENT_ID=subscriber
TEMP_THRESHOLD=25.0  # Temperature threshold in Celsius
